# Telegram bot token from @BotFather
BOT_TOKEN=

# fal.ai API key from https://fal.ai/dashboard/keys
FAL_KEY=

# Postgres connection string (Neon in production, e.g.
# postgresql://user:pass@ep-xxx-pooler.REGION.aws.neon.tech/db?sslmode=require).
# If unset, an embedded in-memory Postgres is used — fine for tests/local,
# but NOT persistent, so a real deployment MUST set this.
DATABASE_URL=

# 🔫 patrons (the in-app currency) granted to every new user on signup.
# 4 = exactly one Nano Banana 2 render (the free-trial model, best price/quality).
FREE_CREDITS=4

# --- Referral program (all optional; defaults shown) ---
# Extra patrons the INVITED friend gets on top of FREE_CREDITS when they join
# via a referral link (the only farmable surface — keep it small).
REFERRAL_JOIN_BONUS=3
# One-time patrons paid to the INVITER when their friend makes their 1st purchase.
REFERRAL_FIRST_PURCHASE_BONUS=10
# Lifetime share (0–1) of every pack a referred friend buys, paid to the inviter.
REFERRAL_PERCENT=0.05

# --- Partner program v2 (admin-enrolled codes; docs/partner-program.md) ---
# BASE cashback only — PARTNER_TIERS (src/models.ts) raises it to 12/15/20% as a
# partner's codes bring revenue in, and an existing partner keeps their stored
# rate, so lowering this cannot cut anyone already enrolled.
PARTNER_PERCENT=0.10          # base cashback share of invitees' purchases (withdrawable)
PARTNER_WELCOME=60            # one-time enrolment bonus 🔫 (spend-only)
PARTNER_INVITEE_BONUS=5       # 🔫 the invited user gets on top of FREE_CREDITS
PARTNER_MAX_CODES=10          # active codes per account
WITHDRAW_MIN=500              # minimum withdrawable 🔫 to request a cash-out

# Comma-separated Telegram user IDs with access to /stats, /funnel, /dash, /payouts, /orders
ADMIN_IDS=

# --- 48-hour re-engagement nudge (docs/growth-product.md) ---
# Once-daily sweep that DMs users who went dormant (>48h, but active within 14d),
# at most once each. Outbound messaging — set REENGAGE_ENABLED=false to disable.
REENGAGE_ENABLED=true
REENGAGE_HOUR_UTC=7      # 7 UTC = 10:00 МСК
REENGAGE_BATCH=50        # max users nudged per daily sweep

# --- Conversion pushes ---
# HARD ceiling on proactive messages per user per week, counted across EVERY
# push track at once. A messaging channel earns a little per message and loses
# everything at once (a blocked bot is permanent), so this is a product limit,
# not a per-campaign knob — campaigns compete for a slot inside it. 0 disables
# all proactive messaging.
PUSH_PER_WEEK=2
PUSH_BATCH=50
# Bonus patrons attached to the paywall push, live for PUSH_OFFER_HOURS from the
# moment it is sent. Ships at 0 on purpose: read /pushes first. A discount on a
# push that doesn't convert is money handed to people who would have paid
# anyway, and you cannot tell those apart after the fact.
PUSH_OFFER_BONUS=0
PUSH_OFFER_HOURS=48

# --- Async generation reaper (docs/async-generation.md) ---
# Renders run detached (the bot never blocks). A generation still 'pending' beyond
# this many minutes is treated as a render whose process died, then failed +
# refunded (renders take 1–3 min).
GEN_STALE_MINUTES=15

# --- Identity-gate the free hook (docs/growth-product.md) ---
# Require a verified phone (Telegram contact) before the free scenario, and tie
# the gift to the PHONE — so multi-account farming needs multiple real numbers.
# OFF by default (adds onboarding friction); turn on when scaling PAID acquisition.
FREE_GATE_ENABLED=false

# --- Payments: Kaspi (KZT) — see docs/kaspi.md ---
# Kaspi payment link shown to buyers. Blank = buy flow records the order but tells
# the user payment isn't open yet. Set to go live with YOUR merchant link — never
# commit a real one (format: https://pay.kaspi.kz/pay/<your-merchant-token>).
KASPI_PAY_URL=
# Optional per-pack FIXED-AMOUNT links — the way to "pre-fill the amount" without
# an unreliable ?amount= param: create one Kaspi link per pack and map it here.
# KASPI_PAY_URL_<PACKID> (FIRST_SET/PHOTO_SET/START/POPULAR/PRO/VIDEO_SET/STUDIO/
# COURSE_FAST/COURSE_FLAGSHIP);
# unset → falls back to KASPI_PAY_URL (the buyer then enters/confirms the amount).
#
# THESE GO STALE ON A REPRICE. A fixed-amount link carries the amount that was
# baked into it in Kaspi Pay, and nothing in this repo can see or correct it —
# so after the 2026-07-28 reprice every one of these needs recreating at the new
# price, or the buyer is quoted one number by the bot and charged another by
# Kaspi. Current prices live in PACKS (src/models.ts); a stale link is worse
# than no link, since the blank fallback at least lets the buyer type the amount.
KASPI_PAY_URL_FIRST_SET=
KASPI_PAY_URL_PHOTO_SET=
KASPI_PAY_URL_START=
KASPI_PAY_URL_POPULAR=
KASPI_PAY_URL_PRO=
KASPI_PAY_URL_VIDEO_SET=
KASPI_PAY_URL_STUDIO=
# --- Kaspi auto-approval (merchant API) — removes the manual admin approve. ---
# Push: KASPI_API_SECRET enables the signed POST /api/kaspi/callback webhook
# (HMAC-SHA256 over the raw body). Blank → callback route disabled (404).
KASPI_API_SECRET=
KASPI_SIGNATURE_HEADER=x-kaspi-signature
# Pull: KASPI_API_BASE + KASPI_API_TOKEN let «Я оплатил» query the order's real
# status from Kaspi. Blank → the button pings an admin.
# ⚠️ Confirm the exact endpoint/signature/fields against Kaspi's merchant docs
# before enabling either path (docs/kaspi.md).
KASPI_API_BASE=
KASPI_API_TOKEN=
# Grant patrons with NO human in the loop when the query above says "paid".
# Default OFF even when the API is configured: «Я оплатил» is pressed by the
# BUYER, so this trusts one external endpoint completely — a wrong base URL or
# an optimistic staging endpoint becomes free patrons with nobody asked. Off,
# the same tap pings an admin carrying Kaspi's verdict: one tap, no leak.
# Turn on only after watching the verifier agree with reality on real payments.
KASPI_AUTOGRANT=
# ₸ per USD — digest gross-margin estimate only, never pricing.
KZT_PER_USD=480
# Offer window for any pack flagged `offer` in PACKS. NOTHING is flagged that way
# today: the below-ladder entry price is «Первый набор», which is `once` rather
# than `offer` and needs no clock (it is gone per account, not per calendar). So
# this window currently governs nothing — it stays wired for the next real
# countdown sale. The COMBO_ prefix is historical, from the single "combo" pack
# that was split into a photo set and a video set; kept so existing deployments
# don't lose their configuration.
COMBO_OFFER_DAYS=30
COMBO_OFFER_START=

# --- GenAI course cohort delivery (docs/course/README.md) ---
# Course tiers ("course_fast" 3 800 ₸ / "course_flagship" 25 000 ₸, see /course) grant
# patrons like any pack, PLUS a one-time invite link into that tier's private
# Telegram cohort channel. Manual setup required per tier (the Bot API cannot
# create channels): 1) create a private Telegram group/channel, 2) add THIS bot
# as admin with "Invite users via link" permission, 3) paste its numeric chat id
# below (format: -100xxxxxxxxxx). Leave blank until then — purchases still
# succeed and grant credits, they just log an error and skip the invite (no
# purchase is ever dropped/rolled back because this is unset).
COURSE_FAST_CHANNEL_ID=
COURSE_FLAGSHIP_CHANNEL_ID=

# --- Telegram Mini App (web layer), optional ---
# Public HTTPS URL of the deployed Mini App. When set, the bot shows a
# "🌐 Приложение" button/menu and the app server starts. Also set the domain
# in @BotFather (Bot Settings → Configure Mini App).
WEBAPP_URL=
# Port the Mini App server listens on (behind your HTTPS reverse proxy)
WEBAPP_PORT=8080
# Bot username (without @) — used for the Mini App's "Пополнить" deep link
BOT_USERNAME=
# Domain Caddy provisions HTTPS for (docker-compose). Match WEBAPP_URL's host,
# e.g. WEBAPP_DOMAIN=app.example.com and WEBAPP_URL=https://app.example.com
WEBAPP_DOMAIN=

# --- AI Video Translator / dubbing (docs/video-translator-spec.md) ---
# ElevenLabs Dubbing API key. Blank → the dubbing feature is disabled.
ELEVENLABS_API_KEY=
# Kazakh target gated behind Phase-0 validation (KK TTS is v3-alpha). RU/EN ship
# without this. Set true once a native-speaker test dub passes.
DUB_KAZAKH_ENABLED=false
# Max source length (seconds) accepted for a dub. v1 = 60 (15s demo mode).
DUB_MAX_SECONDS=60
# Provider cost per source-SECOND (USD) — PLACEHOLDER until measured in Phase 0.
DUB_USD_PER_SEC=0.02

# --- Content moderation (src/moderation.ts) ---
# Every uploaded photo is screened by fal's hosted NSFW classifier before it
# can be used as generation input — no separate account, same FAL_KEY above.
# Threshold is the nsfw_probability (0-1) at/above which an image is rejected;
# conservative by default (reject more, not less). Tune once real traffic
# gives calibration data.
MODERATION_NSFW_THRESHOLD=0.4

# Hosts a client may name when handing /api/generate an image URL. Every
# legitimate one is a URL WE issued (an /api/upload result, or a previous
# generation's output), so anything else is a caller pointing us at an address
# of their own — which would skip the upload moderation gate. Comma-separated
# host suffixes, matched on hostname boundaries. Change this ONLY if the media
# provider renames its CDN; a wrong value makes every generation fail with
# bad_source. Leave unset to use the built-in default.
# MEDIA_HOST_SUFFIXES=fal.media,fal.run

# --- Rate limiting (src/ratelimit.ts) — per client IP, per 60s window ---
# Backstop against scripted hammering on cost/abuse-sensitive write routes.
# Read-only polling (/api/me, /api/generations*) is never limited.
RATE_LIMIT_AUTH_PER_MIN=30
RATE_LIMIT_UPLOAD_PER_MIN=30
RATE_LIMIT_GENERATE_PER_MIN=30
RATE_LIMIT_ENHANCE_PER_MIN=20

# How far BACK the payment reconciler may reach. It exists to finish a grant
# interrupted minutes ago by a crash; it must never resurrect an old order.
# granted_at was added to an existing table with no backfill, so every order
# marked paid before that migration reads as "never granted" — unbounded, the
# sweep re-credits history: fake revenue in the digest, duplicate referral
# payouts, and a second course invite to someone who bought months ago.
ORDER_GRANT_MAX_AGE_HOURS=48
